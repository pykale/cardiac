# The source distribution carries what running the test suite needs: the tests, and the
# examples they compose. Neither holds data -- every cohort a test uses is generated --
# and the exclusions below keep anything recording-, image- or checkpoint-shaped out.
# The wheel is unaffected: it ships the library alone.
graft tests
# Tests of the repository's .github automation, which a distribution does not carry.
prune tests/github
graft examples
graft docs
graft tutorials
include AGENTS.md API_overview.md

prune outputs
# The tutorials run from their own folder, so that is where they download and unpack their
# dataset and write their runs; none of it belongs in a distribution.
prune tutorials/*/data
prune tutorials/*/outputs
global-exclude __pycache__ *.py[cod] *.npy *.npz *.pt *.pth *.ckpt *.dcm *.edf *.hea *.dat *.zip
